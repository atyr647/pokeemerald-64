# ============================================================
#  Makefile.n64  —  pokeemerald N64 port build system
#  Target: Nintendo 64 (.z64 big-endian ROM, big-endian MIPS -EB)
#  Toolchain: mipsel-linux-gnu-gcc (big-endian mode -EB, bare-metal)
#
#  Why little-endian MIPS?
#    The GBA is little-endian.  All game data (palettes, tilemaps,
#    compressed data) is stored in little-endian byte order.
#    Compiling as little-endian MIPS means all struct layouts, u16/u32
#    reads from ROM data, and save data are correct without byte-swapping.
#    The N64 hardware registers (VI, AI, SI, PI, MI) are always big-endian
#    regardless of CPU mode; our HAL wraps those with N64_MMIO_RD/WR macros.
# ============================================================

SHELL := /bin/bash

# ---------- Basic configuration ----------------------------
FILE_NAME  := pokeemerald64
BUILD_DIR  := build/n64
ROM_NAME   := $(FILE_NAME).z64
EMU_ROM    := $(FILE_NAME)-emu.z64
ELF_NAME   := $(FILE_NAME).elf
MAP_NAME   := $(FILE_NAME).map

# ---------- Toolchain (mipsel = little-endian MIPS) -------
PREFIX := mipsel-linux-gnu-

CC      := $(PREFIX)gcc
AS      := $(PREFIX)as
LD      := $(PREFIX)ld
OBJCOPY := $(PREFIX)objcopy
OBJDUMP := $(PREFIX)objdump
NM      := $(PREFIX)nm
SIZE    := $(PREFIX)size

# ROM CRC fixer — build our own if not present
PYTHON  := python3
CHKSUM64 := $(BUILD_DIR)/tools/n64crc
CHKSUM64_SRC := tools/n64crc.c

# Data processing tools (host native)
PREPROC     := tools/preproc/preproc
PREPROC_SRC := tools/preproc
GFX         := tools/gbagfx/gbagfx
GFX_SRC     := tools/gbagfx
CHARMAP     := charmap.txt

# ---------- Compiler flags --------------------------------
# -mips3       : MIPS III ISA  (VR4300 supports MIPS III)
# -mabi=32     : 32-bit ABI    (o32, avoids 64-bit ABI surprises)
# -EL          : little-endian output (implicit in mipsel- prefix, explicit here)
# -G0          : no small-data section (gp-relative addressing off — we have no gp)
# -mno-abicalls: no PIC, direct calls (bare-metal)
# -fno-pic     : no position-independent code
ARCH_FLAGS := -mips3 -mabi=32 -EB -G0 -mno-abicalls -fno-pic -mhard-float

CFLAGS := $(ARCH_FLAGS)                \
           -O2                         \
           -ffunction-sections         \
           -fdata-sections             \
           -fno-strict-aliasing        \
           -ffreestanding              \
           -Wall                       \
           -Wno-unused-function        \
           -Wno-unused-variable        \
           -Wno-unused-but-set-variable \
           -Wno-sign-compare           \
           -Wno-type-limits            \
           -Wno-address                \
           -Wno-array-bounds           \
           -Wno-missing-braces         \
           -Wno-discarded-qualifiers   \
           -Wno-incompatible-pointer-types \
           -DN64_PORT=1                \
           -DMODERN=1                  \
           -DNDEBUG                    \
           -DBUGFIX                    \
           -D_FORTIFY_SOURCE=0         \
           -I include                  \
           -I include/n64              \
           -iquote include             \
           -iquote include/n64

# CPP flags for the data assembly preprocessing step (no ARCH_FLAGS — runs on host)
# -include data/n64_specials_constants.inc: pre-defines SPECIAL_* constants so that
#   .2byte SPECIAL_X in specialvar macros resolves to an absolute value (no BFD_RELOC_16)
CPP_DATA_FLAGS := -E -DN64_PORT=1 -DMODERN=1 -Iinclude -Iinclude/n64 \
                  -include data/n64_specials_constants.inc

ASFLAGS := $(ARCH_FLAGS) -EB -iquote include -iquote include/n64

LDFLAGS := -T n64.ld                   \
            -Map $(BUILD_DIR)/$(MAP_NAME) \
            -m elf32btsmip             \
            --gc-sections              \
            -u N64Main                 \
            -u N64_DispatchIntr        \
            -nostdlib                  \
            -static

# ---------- Source files ----------------------------------

# N64 platform sources (new files replacing GBA HAL)
N64_SRCS := \
    src/n64/crt0.s              \
    src/n64/platform.c          \
    src/n64/interrupt.c         \
    src/n64/bios.c              \
    src/n64/vi.c                \
    src/n64/tile_renderer.c     \
    src/n64/sprite_renderer.c   \
    src/n64/rdp.c               \
    src/n64/audio.c             \
    src/n64/m4a_core.c          \
    src/n64/input.c             \
    src/n64/flashram.c          \
    src/n64/dma3_stub.c         \
    src/n64/gpu_regs_n64.c      \
    src/n64/rtc_stub.c          \
    src/n64/link_stub.c         \
    src/n64/scanline_effect_n64.c \
    src/n64/rom_header.s        \
    src/n64/libc_impl.c

# Game sources — everything in src/ except files we replace
# Exclude GBA-specific hardware files superseded by N64 equivalents
EXCLUDED_SRCS := \
    src/m4a_1.s            \
    src/crt0.s             \
    src/rom_header.s       \
    src/agb_flash.c        \
    src/agb_flash_1m.c     \
    src/agb_flash_le.c     \
    src/agb_flash_mx.c     \
    src/libgcnmultiboot.s  \
    src/siirtc.c           \
    src/librfu_sio32id.c   \
    src/librfu_rfu.c       \
    src/librfu_intr.c      \
    src/librfu_stwi.c      \
    src/gpu_regs.c         \
    src/link.c             \
    src/link_rfu_2.c       \
    src/link_rfu_3.c       \
    src/scanline_effect.c  \
    src/rtc.c              \
    src/libisagbprn.c      \
    src/multiboot.c        \
    src/dma3_manager.c

# All C sources from src/ (excluding replaced files)
ALL_C_SRCS    := $(shell find src -maxdepth 1 -name '*.c' | sort)
ALL_ASM_SRCS  := $(shell find src -maxdepth 1 -name '*.s' | sort)
EXCLUDED_SET  := $(EXCLUDED_SRCS)

GAME_C_SRCS   := $(filter-out $(EXCLUDED_SET), $(ALL_C_SRCS))
GAME_ASM_SRCS := $(filter-out $(EXCLUDED_SET), $(ALL_ASM_SRCS))

# data/*.s — GBA event scripts, text strings, battle scripts, sound data.
# These use preproc -e to convert C enums → GAS .equiv directives before assembly.
DATA_ASM_SRCS := $(shell find data -maxdepth 1 -name '*.s' | sort)

ALL_SRCS := $(N64_SRCS) $(GAME_C_SRCS) $(GAME_ASM_SRCS)

# ---------- Objects ---------------------------------------
C_SRCS   := $(filter %.c,   $(ALL_SRCS))
ASM_SRCS := $(filter %.s,   $(ALL_SRCS))

C_OBJS      := $(patsubst %.c,   $(BUILD_DIR)/%.o, $(C_SRCS))
ASM_OBJS    := $(patsubst %.s,   $(BUILD_DIR)/%.o, $(ASM_SRCS))
DATA_OBJS   := $(patsubst data/%.s, $(BUILD_DIR)/data/%.o, $(DATA_ASM_SRCS))

# ---------- Music ------------------------------------------
# Every song is a MIDI file that mid2agb turns into an M4A track-command
# stream. The port used to link src/n64/song_stubs.c instead -- 530 song
# headers that all pointed at a single FINE command -- so the song table
# resolved and nothing ever played. tools/n64_song_fixup.sh covers the three
# ways mid2agb's output differs from what MIPS gas expects.
MID_SUBDIR   := sound/songs/midi
MID_BUILDDIR := $(BUILD_DIR)/$(MID_SUBDIR)
MID_CFG      := $(MID_SUBDIR)/midi.cfg
MID          := tools/mid2agb/mid2agb

# The sampled instruments live as .wav next to 9-byte placeholder .bin files
# that were committed in their place, so the ROM held no sample data either.
# wav2agb turns each one into a struct WaveData followed by signed 8-bit
# samples; tools/n64_wavedata_be.py then flips the header's five integer
# fields, so the runtime reads them as plain C on a big-endian machine
# instead of byte-swapping in the mixer's inner loop.
WAV2AGB      := tools/wav2agb/wav2agb
SAMPLE_WAVS  := $(sort $(wildcard sound/direct_sound_samples/*.wav))
CRY_WAVS     := $(sort $(wildcard sound/direct_sound_samples/cries/*.wav))
SAMPLE_BINS  := $(SAMPLE_WAVS:.wav=.bin) $(CRY_WAVS:.wav=.bin)

MID_SRCS := $(sort $(wildcard $(MID_SUBDIR)/*.mid))
MID_OBJS := $(patsubst $(MID_SUBDIR)/%.mid, $(MID_BUILDDIR)/%.o, $(MID_SRCS))

ALL_OBJS    := $(C_OBJS) $(ASM_OBJS) $(DATA_OBJS) $(MID_OBJS)

# ---------- Build rules -----------------------------------
.PHONY: all clean rom emu crc-tool preproc-tool gfx-tool

all: rom

rom: crc-tool preproc-tool gfx-tool $(BUILD_DIR)/$(ROM_NAME)

# `make -f Makefile.n64 emu` — the same ROM with a different IPL3, for
# mupen64plus and the cores derived from it. See tools/ipl3.s for why those
# emulators need a boot stub that leaves RDRAM alone. Everything after the
# 4 KB header is byte-identical to the hardware ROM.
emu: $(BUILD_DIR)/$(EMU_ROM)

# ---------- Music build rules ------------------------------
$(MID): $(wildcard tools/mid2agb/*.cpp tools/mid2agb/*.h)
	$(MAKE) -C tools/mid2agb

# mid2agb emits GOTO and PATT targets as `.word <label>` inside the track's
# command stream, at whatever byte offset the stream has reached. ARM gas
# leaves those where they are; MIPS gas aligns data directives to their own
# size by default, so it quietly pads the stream with zero bytes and the
# player reads a NOP-ish 0x00 where a command should be. `.align 0` turns
# that automatic alignment off. mid2agb writes exactly one `.align 2` before
# the track data and one before the song header, so inserting `.align 0`
# after the first leaves the header aligned while packing the streams.
SONG_FIXUP := tools/n64_song_fixup.sh
MID_ASFLAGS := -mips3 -mabi=32 -EB -G0

# One rule per line of midi.cfg: everything after the colon is that song's
# mid2agb options (voicegroup, reverb, master volume).
# $1: song name, $2: options
define N64_MID_RULE
$(MID_BUILDDIR)/$1.s: $(MID_SUBDIR)/$1.mid $(MID_CFG) $(MID)
	@mkdir -p $$(@D)
	$(MID) $$< $$@ $2
	@$(SONG_FIXUP) $$@
endef

define N64_MID_EXPANSION
$(eval $(call N64_MID_RULE,$(basename $(patsubst %:,%,$(word 1,$1))),$(wordlist 2,999,$1)))
endef

$(foreach line,$(shell sed "s/ /__SPACE__/g" $(MID_CFG)),\
    $(call N64_MID_EXPANSION,$(subst __SPACE__, ,$(line))))

$(WAV2AGB): $(wildcard tools/wav2agb/*.cpp tools/wav2agb/*.h)
	$(MAKE) -C tools/wav2agb

# Cries are DPCM-compressed and single-shot; everything else is plain PCM.
sound/direct_sound_samples/cries/%.bin: sound/direct_sound_samples/cries/%.wav $(WAV2AGB) tools/n64_wavedata_be.py
	$(WAV2AGB) -b -c -l 1 --no-pad $< $@
	@$(PYTHON) tools/n64_wavedata_be.py $@

sound/%.bin: sound/%.wav $(WAV2AGB) tools/n64_wavedata_be.py
	$(WAV2AGB) -b $< $@
	@$(PYTHON) tools/n64_wavedata_be.py $@

# MPlayDef.s holds the command-name equates every song includes. It needs the
# same comment-stripping, so a fixed-up copy lives next to the songs and comes
# first on the include path.
$(MID_BUILDDIR)/MPlayDef.s: sound/MPlayDef.s $(SONG_FIXUP)
	@mkdir -p $(@D)
	cp $< $@
	@$(SONG_FIXUP) --defs $@

$(MID_BUILDDIR)/%.o: $(MID_BUILDDIR)/%.s $(MID_BUILDDIR)/MPlayDef.s
	@mkdir -p $(@D)
	$(AS) $(MID_ASFLAGS) -I $(MID_BUILDDIR) -I sound -o $@ $<

# Build the N64 CRC fixer tool (host native, not MIPS)
crc-tool: $(CHKSUM64)
$(CHKSUM64): $(CHKSUM64_SRC)
	@mkdir -p $(dir $@)
	gcc -O2 -o $@ $<

# Build the preproc tool (host native C++11)
# If the binary is already present and newer than sources, skip rebuild.
preproc-tool: $(PREPROC)
$(PREPROC): $(wildcard $(PREPROC_SRC)/*.cpp $(PREPROC_SRC)/*.h)
	$(MAKE) -C $(PREPROC_SRC)

# Build the gbagfx tool (host native) — converts PNG/PAL → binary graphics data
gfx-tool: $(GFX)
$(GFX): $(wildcard $(GFX_SRC)/*.c $(GFX_SRC)/*.h)
	$(MAKE) -C $(GFX_SRC)

# Pre-generate all binary graphics data referenced by INCBIN macros in C sources.
# Without this, preproc fails at compile time when it tries to open the binary files.
# This stamp is rebuilt only when gbagfx itself is newer (i.e., on first build or
# after 'make clean').  It scans every C source for INCBIN_* paths, collects the
# ones that don't exist yet, and makes one recursive invocation to build them all
# (honouring the explicit rules in graphics_file_rules.mk / spritesheet_rules.mk
# which carry the right -mwidth/-mheight flags for spritesheets).
GFX_STAMP := $(BUILD_DIR)/.gfx_done
$(GFX_STAMP): $(GFX) Makefile.n64 $(filter %.c, $(ALL_SRCS))
	@mkdir -p $(dir $@)
	@echo "[gfx] Scanning src/ for binary data paths..."
	@# grep recursively through all files under src/ for quoted paths that look
	@# like binary data.  Do NOT filter by 'INCBIN_' first: multi-argument
	@# INCBIN_U32("a", "b", "c") spreads continuation args onto separate lines
	@# that lack the INCBIN_ keyword, so a line-level filter misses them.
	@MISSING=$$(grep -rh '"graphics/\|"data/' src/ 2>/dev/null | \
	    grep -oP '(?<=")(graphics|data)/[^"]+(?=")' | \
	    grep -E '\.(4bpp|8bpp|gbapal|lz|rl|1bpp|bin|latfont|hwjpnfont|fwjpnfont)' | \
	    sort -u | \
	    while IFS= read -r f; do [ -f "$$f" ] || echo "$$f"; done); \
	if [ -n "$$MISSING" ]; then \
	    CNT=$$(echo "$$MISSING" | wc -l); \
	    echo "[gfx] Building $$CNT missing binary file(s) (first build takes a few minutes)..."; \
	    $(MAKE) --no-print-directory -j$$(nproc) -f Makefile.n64 $$MISSING || true; \
	fi
	@touch $@

# Link ELF then extract raw binary for ROM
$(BUILD_DIR)/$(ROM_NAME): $(BUILD_DIR)/$(ELF_NAME)
	$(OBJCOPY) -O binary $< $@
	@# Pad to minimum 1 MB
	@SIZE=$$(wc -c < $@); \
	 PAD=$$((1048576 - $$SIZE)); \
	 if [ $$PAD -gt 0 ]; then \
	   dd if=/dev/zero bs=1 count=$$PAD >> $@ 2>/dev/null; \
	 fi
	@# Patch IPL3 into ROM header bytes 0x040-0x0FFF.
	@# Use pre-built libdragon IPL3 binary if present (recognized by SC64);
	@# otherwise fall back to assembling tools/ipl3.s.
	@if [ -f tools/ipl3_libdragon.bin ]; then \
	    python3 tools/patch_ipl3.py --bin tools/ipl3_libdragon.bin $@; \
	else \
	    python3 tools/patch_ipl3.py $@; \
	fi
	@# Fix ROM CRC checksums (computed over ROM[0x1000..], not the IPL3 region)
	$(CHKSUM64) $@
	@echo "ROM built: $@ ($$(wc -c < $@) bytes)"

# Emulator ROM: take the finished hardware ROM, swap in the assembled stub
# from tools/ipl3.s, and re-run the CRC fixer (the checksum covers 0x1000
# onwards, so it does not actually change, but the fixer is cheap and this
# keeps the two ROMs built the same way).
$(BUILD_DIR)/$(EMU_ROM): $(BUILD_DIR)/$(ROM_NAME) tools/ipl3.s tools/patch_ipl3.py
	cp $< $@
	$(PYTHON) tools/patch_ipl3.py --elf $(BUILD_DIR)/$(ELF_NAME) $@
	$(CHKSUM64) $@
	@echo "Emulator ROM built: $@ ($$(wc -c < $@) bytes)"

# Which .rodata blobs stay in cartridge ROM instead of being copied to RDRAM.
# See tools/n64_rodata_split.py and the .rodata.blobs note in n64.ld.
RODATA_SPLIT_LD := $(BUILD_DIR)/rodata_rom.ld

$(RODATA_SPLIT_LD): $(ALL_OBJS) tools/n64_rodata_split.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/n64_rodata_split.py $@ $(ALL_OBJS)

$(BUILD_DIR)/$(ELF_NAME): $(ALL_OBJS) n64.ld $(RODATA_SPLIT_LD)
	@mkdir -p $(dir $@)
	$(LD) $(ALL_OBJS) $(LDFLAGS) -o $@
	$(SIZE) $@

# Compile C — run preproc first to handle INCBIN_* macros (embeds binary data)
# Pipeline: C source → CPP preprocess → preproc (expands INCBIN to hex) → compile
# set -o pipefail: fail the rule if any stage in the pipe fails (prevents
# silent empty .o when preproc is missing)
# $(PREPROC) as a real (non-order-only) prerequisite: if preproc is rebuilt
#   (first build, or after 'make clean'), all .o files are considered stale
#   and get recompiled.  This prevents stale empty objects from an earlier
#   run where preproc was not yet available.
# | $(GFX_STAMP): order-only — all binary data files are ready before preproc
#   is invoked (preproc opens them to inline their bytes as hex literals).
$(BUILD_DIR)/%.o: %.c $(PREPROC) | $(GFX_STAMP)
	@mkdir -p $(dir $@)
	set -o pipefail; $(CC) $(CFLAGS) -E $< | $(PREPROC) -ib $< $(CHARMAP) | sed 's/__asm__("svc [0-9]*")/__asm__("break")/g' | $(CC) $(CFLAGS) -MMD -MP -x c -c - -o $@

# Assemble .s (N64 platform sources)
$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -x assembler-with-cpp -c $< -o $@

# Assemble data/*.s — GBA game data (scripts, text, battle animations, sound)
# Pipeline: preproc (charmap) → host CPP (expand #includes, -e converts enums→.equiv) → preproc -ie → as
# Note: $(AS) is the bare assembler; use only assembler-compatible flags (not GCC-only flags).
# set -o pipefail: without it a failure in any stage but the last is discarded and
#   $(AS) happily assembles the truncated/empty stream into a valid-but-empty .o.
#   make then treats that object as up to date, and the link fails much later with
#   thousands of undefined references (or worse, silently drops game data).
# | $(GFX_STAMP): order-only — these sources .incbin generated graphics/data files,
#   so asset generation must finish before the assembler runs.  Without this the
#   rule races against the gfx step under -j and produces empty objects.
AS_ARCH_FLAGS := -mips3 -mabi=32 -EB -G0
# sound_data.s .incbin's every sample, so they have to exist first.
$(BUILD_DIR)/data/sound_data.o: $(SAMPLE_BINS)

$(BUILD_DIR)/data/%.o: data/%.s | $(GFX_STAMP)
	@mkdir -p $(dir $@)
	set -o pipefail; $(PREPROC) -b $< charmap.txt | gcc $(CPP_DATA_FLAGS) - | $(PREPROC) -ieb $< charmap.txt | $(AS) $(AS_ARCH_FLAGS) -o $@

# ---------- Data file generation rules ----------------------------
# Generate 4bpp/8bpp/pal binary data from source files using gbagfx.
# These are needed by INCBIN_U32 macros in game source files.
# Explicit per-file rules (with special -mwidth/-mheight flags for spritesheets)
# are supplied by the original GBA build system's rule files:
include graphics_file_rules.mk
include spritesheet_rules.mk
# Fallback pattern rules for files not covered by the explicit rules above:
%.4bpp:   %.png  ; $(GFX) $< $@
%.8bpp:   %.png  ; $(GFX) $< $@
%.gbapal: %.pal  ; $(GFX) $< $@
%.gbapal: %.png  ; $(GFX) $< $@
%.lz:     %      ; $(GFX) $< $@
%.rl:     %      ; $(GFX) $< $@
%.1bpp:   %.png  ; $(GFX) $< $@

clean:
	rm -rf $(BUILD_DIR)

# Include generated dependency files
-include $(C_OBJS:.o=.d)

# Convenience targets
disasm: $(BUILD_DIR)/$(ELF_NAME)
	$(OBJDUMP) -d -M no-aliases $< > $(BUILD_DIR)/$(FILE_NAME).dis

sizes: $(BUILD_DIR)/$(ELF_NAME)
	$(NM) --size-sort --print-size $< | head -40
